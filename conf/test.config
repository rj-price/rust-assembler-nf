/*
 * Smoke-test profile.
 *
 * Purpose: prove the wiring, container pulls, database binds and offline BUSCO all work —
 * NOT to produce a meaningful assembly. Uses a small head-subsample of each run.
 *
 * Create the test inputs first (cheap, a couple of minutes):
 *   RAW_DIR=/path/to/your/fastqs bash bin/make_test_data.sh
 *
 * Then, with a site profile:
 *   nextflow run . -profile test,gruffalo
 */

params {
    input             = "${projectDir}/assets/samplesheet_test.csv"

    // Onto scratch when the cluster provides it, since a site profile may (rightly) refuse
    // an outdir under $HOME and the smoke test is normally launched from the repo.
    outdir            = System.getenv('SCRATCH')
                            ? "${System.getenv('SCRATCH')}/rust-assembler-nf-test/results"
                            : "${launchDir}/test_results"

    // genome_size stays REAL — it is not a test knob. Flye uses it to estimate coverage, and
    // claiming 5 Mb for reads sampled from a ~450 Mb genome implies ~440x and sends Flye off
    // doing enormous amounts of pointless work. 450m is a representative rust; override with
    // --genome_size if your test reads come from something very different.
    genome_size       = '450m'

    // The size_flag bounds ARE relaxed, because a subsample genuinely cannot reach the
    // dikaryon size range and every assembly would otherwise be flagged 'collapsed', making
    // a healthy test look broken.
    dikaryon_size_frac_min = 0.000001
    dikaryon_size_frac_max = 1000

    // Keep the smoke test to the fast path. The heavyweight tools are exercised separately
    // via -stub-run, since Kraken2/FCS-GX need hundreds of GB regardless of input size.
    run_hicanu        = false
    run_flye          = true
    run_kraken2       = false
    run_fcs_gx        = false
    run_smudgeplot    = false

    // Merqury CANNOT work on a shallow subsample and this is not a wiring problem: at ~4x
    // coverage the k-mer histogram is dominated by error singletons with no usable peak, so
    // merqury's ploidy detection picks a nonsense boundary and filters out essentially every
    // k-mer, leaving nothing to compute QV from. It needs real depth to be meaningful, so it
    // is disabled here rather than left to fail confusingly.
    run_merqury       = false

    max_cpus          = 16
    max_memory        = '64.GB'
    max_time          = '4.h'
}

process {
    // resourceLimits alone is enough to shrink the whole pipeline to test size: Nextflow
    // clamps every request to these ceilings, so FLYE's 64 CPU / 900 GB / 7 d becomes
    // 16 / 64 GB / 4 h without naming FLYE at all.
    //
    // Per-process blocks used to live here as well and were actively harmful: a `withName`
    // selector repeated in two config files REPLACES the other file's block rather than
    // merging with it, so `withName: 'FLYE'` here silently deleted FLYE's container from
    // conf/base.config — meaning the smoke test, whose entire purpose is proving the
    // containers work, would have run Flye and BUSCO outside a container.
    // See bin/check_config_selectors.py.
    resourceLimits = [ cpus: 16, memory: 64.GB, time: 4.h ]
}
