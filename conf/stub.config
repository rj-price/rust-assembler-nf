/*
 * Stub-run profile: validate wiring only.
 *
 * -stub-run still honours resource directives, so on a login/dev shell the real requests
 * (64 CPU, 500 GB) fail with "Process requirement exceeds available CPUs". This profile
 * shrinks everything to something a single core can satisfy.
 *
 * Usage:
 *   nextflow run . --input assets/samplesheet.csv -profile stub -stub-run
 */

process {
    executor       = 'local'
    resourceLimits = [ cpus: 1, memory: 2.GB, time: 1.h ]
    cpus           = 1
    memory         = 1.GB
    time           = 10.m
    container      = null
}

apptainer.enabled   = false
docker.enabled      = false
singularity.enabled = false

executor {
    name      = 'local'
    cpus      = 1
    memory    = 2.GB
    queueSize = 4
}
