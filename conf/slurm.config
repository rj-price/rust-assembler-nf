/*
 * SLURM execution — generic.
 *
 * Partition/queue ROUTING is site-specific and deliberately not here: queue names and
 * per-user caps differ on every cluster. A site profile sets `process.queue` (see
 * conf/gruffalo.config for the worked example). Without one, jobs go to the cluster's
 * default partition, which is fine for a small cluster and wrong for a large one.
 *
 * The pipeline driver itself must be submitted with sbatch — never run on a head node.
 * See run_pipeline.sh.
 */

process {

    executor = 'slurm'

    // --cpus-per-task is set explicitly because Nextflow otherwise passes -n, which on many
    // SLURM configurations gives you tasks rather than threads.
    //
    // The --exclude is not paranoia: a node with a broken TaskProlog accepts jobs, fails
    // them in under a second with no exit code, and — because it is always free — keeps
    // being picked, so retries land on it too. Three such nodes cost 25, 24 and 40 tasks
    // across three runs here. Set params.exclude_nodes in your site profile when you find
    // one. Empty (the default) adds no flag at all: `--exclude=` on its own is a SLURM error.
    clusterOptions = {
        def opts = "--cpus-per-task=${task.cpus}"
        params.exclude_nodes ? "${opts} --exclude=${params.exclude_nodes}" : opts
    }
}

executor {
    name            = 'slurm'
    queueSize       = 30          // concurrent SLURM jobs from this pipeline
    submitRateLimit = '10/1min'   // be a good neighbour on a shared scheduler
    pollInterval    = '30 sec'
}
