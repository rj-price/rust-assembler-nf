/*
 * SITE PROFILE — gruffalo (Crop Diversity HPC).
 *
 * This file holds everything that is true of THIS CLUSTER and nothing that is true of the
 * pipeline or of a particular dataset. It is the worked example to copy when porting:
 * duplicate it as conf/<yoursite>.config, change the paths, and add a matching profile
 * block in nextflow.config.
 *
 * Every path here is derived from $USER or $SCRATCH where it can be, so a second user on
 * gruffalo needs no edits at all.
 *
 * Deliberately contains NO `withName:`/`withLabel:` blocks. Nextflow does not deep-merge
 * process selectors across files — a repeated selector REPLACES the other file's block
 * wholesale and silently. Resources and containers belong together in conf/base.config.
 * bin/check_config_selectors.py enforces this.
 */

params {

    // ---- Mirrored databases ---------------------------------------------------------
    // All read-only and shared cluster-wide, so no per-user copies are needed.
    //
    // Kraken2. Four databases are mirrored here; the choice is a real trade-off, because
    // KRAKEN2 runs with --memory-mapping and so is bound by how much of the hash the page
    // cache can hold, not by the memory request:
    //
    //   PlusPFP                        201 GB hash, Sep 2024  <- default; fits in RAM on himem
    //   nt_20251021                    340 GB hash, Oct 2025  <- newest, much wider than PlusPFP
    //   2024_05_30_Kraken2_NCBI_NT     953 GB hash, Jun 2025  <- widest, but see below
    //   kraken2_plants_db              plant-only, not useful here
    //
    // PlusPFP stays the default because it is the only one that comfortably fits in a himem
    // allocation, and read-level classification here is EVIDENCE, not an action — a wider
    // database mostly moves reads out of "unclassified" into named bacteria, which does not
    // change any decision the pipeline makes. On a ~1 Gb bean rust dataset PlusPFP left
    // ~40% unclassified, and FCS-GX post-assembly settled the question anyway.
    //
    // Switch when the unclassified fraction is itself the question:
    //     --kraken_db /mnt/shared/datasets/databases/kraken2/nt_20251021
    //
    // The 953 GB NT database needs a 2.5 T or 3.7 T himem node to be worth using: at 220 GB
    // only a quarter of the hash stays cached and every read page-faults against Lustre.
    // Raise the KRAKEN2 memory request to ~1 TB alongside it, and note that max_memory below
    // clamps to 900 GB, so that ceiling has to move too.
    kraken_db     = '/mnt/shared/datasets/databases/kraken2/PlusPFP'   // 201 GB hash
    busco_db      = '/mnt/shared/datasets/databases/busco/lineages'    // odb12, works offline
    fcs_gx_db     = '/mnt/shared/datasets/databases/fcs'
    fcs_gx_sif    = '/mnt/shared/datasets/databases/fcs/fcs-gx.sif'

    // IPA has no usable stock container (containers/ipa.def says why). Built once per user:
    //     apptainer build /mnt/apps/users/$USER/apptainer_cache/ipa.sif containers/ipa.def
    ipa_sif       = "/mnt/apps/users/${System.getenv('USER')}/apptainer_cache/ipa.sif"

    // Same for the two other locally built images, used only when their branch is switched on.
    nuclearphaser_sif = "/mnt/apps/users/${System.getenv('USER')}/apptainer_cache/nuclearphaser.sif"
    haphic_sif        = "/mnt/apps/users/${System.getenv('USER')}/apptainer_cache/haphic.sif"

    // ---- Containers -----------------------------------------------------------------
    // NOT $HOME: it must stay under ~15 GB and a low file count or SLURM throttles job
    // concurrency, and the image set here runs to tens of GB.
    apptainer_cache = "/mnt/apps/users/${System.getenv('USER')}/apptainer_cache"
    // Databases live outside the work directory, so they are invisible inside a container
    // unless bound explicitly.
    container_binds = '-B /mnt/shared/datasets -B /mnt/shared/scratch -B /mnt/apps'

    // ---- Policy ---------------------------------------------------------------------
    // $HOME here is backed up, size-capped and file-count-capped; an assembly tree in it
    // throttles every job you run. Refuse rather than do it.
    forbid_home_outdir = true

    // ---- Resource ceilings ----------------------------------------------------------
    // Matched to per-user, per-queue cumulative caps on this cluster.
    max_cpus   = 64
    max_memory = '900.GB'
    max_time   = '14.d'

    // ---- Known-bad nodes ------------------------------------------------------------
    // Nodes with a broken SLURM TaskProlog: they accept a job, fail the prolog, and hand it
    // back as FAILED within a second with NO exit code. Three were found across three runs,
    // costing 25, 24 and 40 tasks respectively. Drop each entry once its node is confirmed
    // fixed, and set '' if you hit none.
    exclude_nodes = 'n24-64-384-dawn,n19-64-3072-thanos,n23-64-4096-voldemort'
}

// Work directory belongs on scratch: assemblies and BAMs are far too large for $HOME.
// Scratch is NOT backed up and is purged after 180 days, so copy anything that matters to
// $PROJECTS once a run is judged good. Over 25 TB of scratch throttles you to one
// concurrent job, so clean up finished work directories.
workDir = "${(System.getenv('SCRATCH') ?: "/mnt/shared/scratch/${System.getenv('USER')}").replaceAll('/+$', '')}/nextflow-work/rust-assembler-nf"

/*
 * Partition routing.
 *
 * This matters more than usual here: per-user limits are CUMULATIVE across all your running
 * jobs in a queue, so a job asking for more than the queue's cap sits PENDING forever rather
 * than failing.
 *
 *   short   6 h    256 CPU / 256 G (per-user)
 *   medium  24 h   256 CPU / 256 G   <- cluster default partition
 *   long    14 d   384 CPU / 384 G
 *   himem   14 d   256 CPU / up to 4 T   (nodes of 629 G, 2.5 T, 3.7 T)
 *
 * The himem threshold is 100 GB, not 250 GB, precisely BECAUSE the caps are cumulative: a
 * single 200 GB task on `medium` consumes 78% of the 256 GB allowance, so everything else
 * queues behind it one at a time. Observed directly — four tasks sat on QOSMaxMemoryPerUser
 * within a minute of a run starting. himem carries 20 TB across 11 nodes; they belong there.
 *
 * The queue is chosen from the CLAMPED request, so retry escalation can move a job up.
 *
 * The threshold stays at 100 GB, and after the 2026-08-26 resource re-sizing that is doing
 * real work rather than sitting inert. himem's binding constraint is not its 20 TB of memory
 * but its 256-CPU cumulative cap, and that cap has to be spent on the critical path:
 *
 *   himem   long assemblers + databases     FLYE 360 G, HICANU 240 G, VERKKO 320 G,
 *                                            KRAKEN2 280 G, FCS_GX 700 G, MERYL_COUNT 128 G,
 *                                            SMUDGEPLOT 260 G
 *   medium  hifiasm + read-to-assembly aln   HIFIASM 96 G / 12 h, MINIMAP2_* 64 G / 8 h
 *   short   everything else                  BUSCO, MERQURY, NANOPLOT, gfastats, reporting
 *
 * The 2026-09-02 re-sizing moved HIFIASM off himem, and that was the point rather than a
 * side effect. Its measured peak is 64.8 GB, so 96 GB is the honest number and it happens to
 * sit below the threshold. Before, the six himem processes asked for 208 CPUs and hifiasm's 64
 * took the total past the 256 cap, so one of them always waited. They now come to 170.
 *
 * MINIMAP2_ASSEMBLY was the case that mattered. At its old 120 GB request it routed to himem
 * and ran 24 tasks at 32 CPUs each, so QC of the assemblies that had already finished starved
 * the assemblers that had not: three concurrent alignments consumed 96 of the 256 himem CPUs.
 * Measured peak is 44.8 GB, so 64 GB is not a trick to dodge himem; it is the honest number,
 * and moving those tasks to `medium` is what lets all four assemblers plus FCS-GX hold himem
 * allocations at the same time. `medium`'s 256 GB cumulative cap throttles them to five
 * concurrent, which is the right trade: QC is not the long pole, HiCanu is.
 */
process.queue = { task.memory  > 100.GB ? 'himem'
                : task.time    > 24.h   ? 'long'
                : task.time    > 6.h    ? 'medium'
                :                         'short' }

/*
 * On gruffalo, --cpus-per-task=N yields N USABLE THREADS (hyperthreads are already counted
 * in SLURM's number). Every module passes task.cpus straight to the tool's thread flag and
 * must never double it.
 */
