/*
 * DATASET PROFILE — Puccinia triticina 19NSW04 (wheat leaf rust).
 *
 * The THIRD validation dataset, and the first outside Melampsora: a different family
 * (Pucciniaceae) with ~123 Mb haploid nuclei. Published by Sperschneider et al., "Nuclear
 * exchange generates population diversity in the wheat leaf rust pathogen Puccinia
 * triticina", Nat Microbiol 2023, doi:10.1038/s41564-023-01494-9. 19NSW04 is the AU2
 * lineage, carrying the B and C nuclear haplotypes; its C haplotype has a chr2/chr6
 * translocation no other haplotype shares.
 *
 * Target metrics are in assets/reference_metrics_pt19NSW04.tsv, taken from the NCBI assembly
 * GCA_029633885.1 and the paper's text. The published haplotypes are Hi-C scaffolded (SALSA,
 * then curated by eye from contact maps), so read that file's header before judging.
 *
 * Data (public, from ENA):
 *     SRR22951832  PacBio Sequel II HiFi, 15.2 Gb   PRJNA902835
 *     SRR22951835  Hi-C MiSeq,            34.7 Gb   PRJNA902835
 *
 * Usage:  nextflow run rj-price/rust-assembler-nf -profile pt,<site> --outdir <dir>
 */

params {

    // ---- Genome expectations --------------------------------------------------------
    // The chromosome haplotypes are 122.08 Mb (B) and 123.74 Mb (C), with 7.17 Mb unplaced,
    // so ~123 Mb haploid and ~246 Mb for the dikaryon. The paper's raw hifiasm haplotypes
    // were 123-129 Mb before scaffolding.
    genome_size           = '123m'
    assembler_genome_size = '123m'

    // 15.2 Gb HiFi (methods) = ENA base_count for SRR22951832. About 62x on the dikaryon,
    // half the depth of mlp: this is also the lower-coverage test of the three.
    read_yield_bases      = 15207978816

    // ---- Species --------------------------------------------------------------------
    fcs_gx_taxid          = 208348                // Puccinia triticina

    // The paper ran BUSCO v3.0.2 against basidiomycota_odb9, so its ">95% complete, <5%
    // duplicated" is not directly comparable to any odb12 number. basidiomycota keeps the
    // lineage the same as mlp/map, which makes the three validation genomes comparable to
    // each other, if not to the paper.
    busco_lineage         = 'basidiomycota_odb12'

    // ---- Assembly -------------------------------------------------------------------
    // The paper used hifiasm 0.16.1 in Hi-C integration mode with DEFAULT parameters, so
    // purge level 3 for a like-for-like reproduction, as for mlp and map.
    hifiasm_purge_level   = 3

    subset_assemblies     = false

    host_reference        = null

    // ---- Full validation run ----------------------------------------------------------
    // As for mlp/map: every input is a public URL, downloaded into the work directory on
    // first use. ENA names the HiFi file _subreads, but it is HiFi (CCS) data.
    input                 = "${projectDir}/assets/samplesheet_pt19NSW04.csv"
    hic_r1                = 'https://ftp.sra.ebi.ac.uk/vol1/fastq/SRR229/035/SRR22951835/SRR22951835_1.fastq.gz'
    hic_r2                = 'https://ftp.sra.ebi.ac.uk/vol1/fastq/SRR229/035/SRR22951835/SRR22951835_2.fastq.gz'

    run_verkko            = true
    run_scaffolding       = true

    // NuclearPhaser needs its container built locally (containers/nuclearphaser.def) and
    // --nuclearphaser_sif set, usually in the site profile. No 19NSW04 gene set is on NCBI,
    // so this is the RefSeq CDS of another P. triticina isolate, Pt15: same species, as the
    // Mlp v1 CDS is for mlp.
    run_nuclearphaser     = true
    nuclearphaser_genes   = 'https://ftp.ncbi.nlm.nih.gov/genomes/all/GCF/026/914/185/GCF_026914185.1_ASM2691418v1/GCF_026914185.1_ASM2691418v1_cds_from_genomic.fna.gz'

    // The paper removed mitochondrial contigs; same database as mlp/map.
    run_mito_screen       = true
    mito_reference        = 'https://ftp.ncbi.nlm.nih.gov/refseq/release/mitochondrion/mitochondrion.1.1.genomic.fna.gz'
}
