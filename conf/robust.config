/*
 * Robust profile — for long unattended runs (e.g. over a weekend).
 *
 * WHY THIS EXISTS
 *
 * Nextflow's default errorStrategy here is 'finish': on an unretryable failure it stops
 * submitting NEW tasks and drains what is running. For an interactive run that is right —
 * you want to know immediately. For a four-day unattended run it is close to catastrophic:
 * a single failure in a cheap QC step at hour one prevents the multi-day assemblies from
 * ever being submitted, and you come back to nothing.
 *
 * This profile isolates failures instead. It suits this pipeline specifically because the
 * whole design is "generate several candidates and compare them" — one candidate or one
 * piece of evidence failing should degrade the comparison, not destroy it.
 *
 * THE TRADE-OFF, STATED PLAINLY: 'ignore' masks genuine bugs. A process that fails here
 * leaves no trace beyond the log and a gap in the summary. So:
 *   - do NOT use this profile for smoke tests or while developing — use the default, where
 *     failures are loud
 *   - after a robust run, ALWAYS check which tasks failed before trusting the outputs:
 *       grep -c FAILED results/pipeline_info/execution_trace.txt
 *       awk -F'\t' '$5=="FAILED"' results/pipeline_info/execution_trace.txt
 *
 * Usage:  nextflow run . -profile robust,gruffalo
 */

process {

    // Retry the failure modes worth retrying (OOM, node faults), then give up on that task
    // alone rather than taking the pipeline down with it.
    // A node-level fault (broken SLURM TaskProlog) kills the task BEFORE it can write an exit
    // code, so task.exitStatus is null and every exit-code test below silently misses it. That
    // is how two separate bad nodes — n24-64-384-dawn, then n19-64-3072-thanos — quietly ate
    // 25 and 24 tasks respectively across two runs: 'ignore' rather than 'retry', so the run
    // reported success with a third of the QC missing. Treat "no exit code" as retryable: the
    // task never ran, so re-running it costs nothing and usually lands on a healthy node.
    errorStrategy = { (task.exitStatus == null
                       || task.exitStatus == Integer.MAX_VALUE
                       || task.exitStatus in [104,134,137,139,140,143,247]) && task.attempt <= 3
                        ? 'retry'
                        : 'ignore' }
    maxRetries    = 3

    // Reporting is the exception: if the summary itself cannot be built we want that to be
    // visible as a failed run, not silently absent. By then the expensive work is cached, so
    // failing costs nothing but a re-run of the final steps.
    withName: 'ASSEMBLY_SUMMARY' { errorStrategy = 'terminate' }
}
