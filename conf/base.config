/*
 * Base resource requirements, by process label.
 *
 * Sizing is calibrated against a ~1 Gb dikaryon assembled from ~60 Gb of HiFi — the
 * Uromyces appendiculatus dataset the pipeline was built on, where these figures were measured
 * rather than guessed. A markedly smaller or larger genome should scale them: run `seff` on your own
 * assembly jobs and adjust, since over-requesting on a shared cluster costs queue time and
 * under-requesting costs days.
 *
 * These are LABELS and per-process overrides only. Queue routing lives in the site profile.
 */

// CRITICAL: every process needing BOTH a container and a resource override must declare them
// TOGETHER in one block here. Nextflow does NOT deep-merge process selector blocks across
// included config files — if the same selector string appears in conf/apptainer.config too,
// that file's block REPLACES this one wholesale and silently. That is how run 32466998 lost
// the resource settings for FLYE, HICANU, KRAKEN2, FCS_GX, MINIMAP2_.*, BUSCO and MERQURY.

process {

    // Nextflow >=24.04 clamps requests to these ceilings rather than failing outright.
    resourceLimits = [
        cpus:   params.max_cpus,
        memory: params.max_memory,
        time:   params.max_time
    ]

    cpus   = 1
    memory = 6.GB
    time   = 2.h

    // Retry on the failure modes that are worth retrying: OOM kills and node/transient faults.
    // Anything else is a real error and should surface immediately rather than burn days.
    // A node-level fault (broken SLURM TaskProlog) kills the task BEFORE it can write an exit
    // code, so task.exitStatus is null and every exit-code test below silently misses it. That
    // is how two separate bad nodes — n24-64-384-dawn, then n19-64-3072-thanos — quietly ate
    // 25 and 24 tasks respectively across two runs: 'ignore' rather than 'retry', so the run
    // reported success with a third of the QC missing. Treat "no exit code" as retryable: the
    // task never ran, so re-running it costs nothing and usually lands on a healthy node.
    errorStrategy = { task.exitStatus == null
                      || task.exitStatus == Integer.MAX_VALUE
                      || task.exitStatus in [104,134,137,139,140,143,247] ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    // ---- Generic labels -------------------------------------------------------------
    //
    // Every figure below is measured, not guessed: see the MEASURED column, taken from
    // .command.trace peak_rss and %cpu across three full runs on a ~1 Gb dikaryon (60 Gb
    // HiFi). The rule applied throughout is REQUEST ~= measured peak x 1.5, because
    // the retry ladder above already doubles cpus/memory/time on attempt 2 and doubles them
    // again on attempt 3. An under-request costs one retry; an over-request costs queue time
    // on every task, on every run, forever.
    //
    // That asymmetry is the whole argument. The 2026-08-24 cluster usage report put this
    // account at 4.6% memory efficiency and 34.9% CPU efficiency; the reserved-but-unused
    // memory was 54,225 GB-hours against 16,869 actually touched.

    withLabel: process_single {
        cpus   = 1
        memory = { 4.GB  * task.attempt }   // MEASURED: <20 MB (ASSEMBLY_RECORD, MULTIQC)
        time   = { 1.h   * task.attempt }
    }

    withLabel: process_low {
        cpus   = 2                          // MEASURED: 1.7 cores (GFASTATS, SEQKIT_STATS)
        memory = { 4.GB  * task.attempt }   // MEASURED: 1.1 GB peak (GFASTATS)
        time   = { 1.h   * task.attempt }   // MEASURED: 5.2 min worst case (SEQKIT_STATS)
    }

    withLabel: process_medium {
        cpus   = 8
        memory = { 24.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }

    withLabel: process_high {
        cpus   = 32
        memory = { 48.GB * task.attempt }
        time   = { 12.h  * task.attempt }
    }

    // k-mer counting over 60 Gb of reads is memory- and disk-hungry. meryl sizes its own
    // hash from 80% of task.memory, so cutting this request genuinely cuts usage rather
    // than just the reservation — it spills to disk instead of failing if the hash is tight.
    withLabel: process_kmer {
        cpus   = 8                          // MEASURED: 6.8 cores busy on the full 60.29 Gb
        memory = { 128.GB * task.attempt }  // MEASURED: 83.3 GB -- do NOT cut, see above
        time   = { 4.h    * task.attempt }  // MEASURED: 1 h 27 m
    }

    // Very large memory, short-ish: database-resident tools. Both users of this label carry
    // their own override below, so this is only a floor.
    withLabel: process_himem {
        cpus   = 16
        memory = { 260.GB * task.attempt }
        time   = { 24.h   * task.attempt }
    }

    // Multi-day assemblies. Each assembler is its own process so that changing a QC plot
    // never invalidates a days-long task — and each now carries its own request, because
    // their memory profiles differ by a factor of four and a shared label had to size for
    // the worst of them.
    withLabel: process_assembly {
        cpus   = 64
        memory = { 320.GB * task.attempt }
        time   = { 5.d    * task.attempt }
    }

    // ---- Per-process overrides ------------------------------------------------------

    // MEASURED: 61 GB peak, 3.6 h, 79% CPU across three read subsets. The old shared
    // process_assembly request of 500 GB / 3 d reserved eight times the memory it used —
    // 3,450 GB-hours reserved against 349 touched, the single worst ratio in the pipeline.
    withName: 'HIFIASM' {
        container = 'https://depot.galaxyproject.org/singularity/hifiasm:0.24.0--h5ca1c30_0'
        cpus   = 64                         // MEASURED: 49.2 cores busy (77%)
        memory = { 96.GB * task.attempt }   // MEASURED: 64.8 GB on the full pooled readset
        time   = { 12.h  * task.attempt }   // MEASURED: 3 h 55 m
    }

    // Flye is markedly more memory-hungry than hifiasm on HiFi data of this volume.
    // MEASURED: 234 GB peak, 14.6 h, 82% CPU.
    withName: 'FLYE' {
        container = 'https://depot.galaxyproject.org/singularity/flye:2.9.6--py39h475c85d_0'
        cpus   = 64                         // MEASURED: 47.3 cores busy (74%)
        memory = { 360.GB * task.attempt }   // MEASURED: 240.1 GB -- 1.5x, on target
        time   = { 24.h   * task.attempt }   // MEASURED: 15 h 48 m
    }

    // HiCanu is the slowest and least predictable step. It must run with useGrid=false
    // inside a single allocation, or it fights the Nextflow executor by self-submitting.
    // MEASURED: 148 GB peak, 55.7 h, 75% CPU — and it reserved 27,873 GB-hours to touch
    // 8,239, more than every other process in the pipeline combined.
    //
    // Cutting the request was only safe once the error strategy was fixed. A bare 'ignore'
    // silently discards a two-day assembly on an OOM kill or a timeout, which is exactly
    // what a tighter request makes more likely; retry those two, ignore anything HiCanu
    // itself does wrong so a bad assembler cannot sink the run.
    withName: 'HICANU' {
        container = 'https://depot.galaxyproject.org/singularity/canu:2.2--ha47f30e_0'
        cpus   = 64                         // MEASURED: 45.9 cores busy (72%)
        memory = { 240.GB * task.attempt }   // MEASURED: 147.8 GB, twice, on two readsets
        time   = { 4.d    * task.attempt }   // MEASURED: 2 d 11 h 40 m
        errorStrategy = { (task.exitStatus == null
                           || task.exitStatus == Integer.MAX_VALUE
                           || task.exitStatus in [104,134,137,139,140,143,247])
                          && task.attempt <= 3 ? 'retry' : 'ignore' }
    }

    // NOT MEASURED — Verkko has never run here, so it keeps the generous process_assembly
    // label. Trim it from .command.trace once it has, the way the other three were.

    // Kraken2 memory-maps the 201 GB PlusPFP hash, so the pages count against the cgroup
    // limit. This is the one request in the file that goes UP: at 220 GB the run reached
    // 99.6% of its allocation (MaxRSS 219.08 GB) and then hit the 12 h wall — job 32471034,
    // which is the only outright resource failure in the usage report. Give the hash room
    // to sit alongside the read buffers rather than fighting them for reclaim.
    withName: 'KRAKEN2' {
        container = 'https://depot.galaxyproject.org/singularity/kraken2:2.1.3--pl5321hdcf5f25_0'
        cpus   = 16                         // MEASURED: 7.4 cores busy of 32 -- it waits on
                                            // the memory-mapped hash, not on CPU
        memory = { 280.GB * task.attempt }   // MEASURED: 190.0 GB -- 1.5x, on target
        time   = { 8.h    * task.attempt }   // MEASURED: 3 h 28 m cold, 20 m with the hash
                                            // already in page cache
    }

    // FCS-GX memory-maps a very large index: all.gxi (321 GB) + all.gxs (177 GB) = 498 GB,
    // and it needs the WHOLE thing resident or it thrashes. At 550 GB there was not enough
    // headroom above the index for the OS to keep it cached: run 32466998 logged
    // "The file is 0% in RAM" after a 27-minute prefetch, then hit the wall at 12 h and again
    // at 24 h. The 700 GB stays: MEASURED peak is 466 GB, and that headroom is what turned a
    // 24-hour timeout into a four-minute task. The 48 h did NOT stay — MEASURED worst case
    // is 40 minutes including a cold-cache prefetch, so 6 h is still nine times over.
    withName: 'FCS_GX' {
        // A CLOSURE, not a bare `params.fcs_gx_sif`. This file is included by
        // nextflow.config BEFORE any profile is parsed, so at that point the param is still
        // null and a bare reference bakes `container = null` in permanently. Nextflow then
        // runs the task on the bare host with no container and no complaint -- which is
        // exactly what happened on 2026-09-01: /app/bin/run_gx does not exist outside the
        // image, so FCS-GX never ran on any of the five assemblies. A closure is resolved
        // per task, long after the profile has set the path.
        container = { params.fcs_gx_sif }
        cpus   = 16
        memory = { 700.GB * task.attempt }
        time   = { 6.h    * task.attempt }
    }

    // MEASURED: 52.7 GB peak, 4.8 h, 75% CPU — and 12,446 GB-hours reserved against 3,410
    // used, second only to HiCanu. Nearly all of the peak was samtools' sort buffer, which
    // defaults to 768 MB PER THREAD and so scaled invisibly with task.cpus; the module now
    // bounds it explicitly, which is what makes this number predictable enough to request.
    // HAPLOTYPE_COMPETITION shares this block: same tools, and its combined hap1+hap2
    // reference is a whole genome, so it maps the same reads against the same total length
    // as MINIMAP2_ASSEMBLY does on a primary.
    withName: 'MINIMAP2_.*|HAPLOTYPE_COMPETITION' {
        container = 'https://depot.galaxyproject.org/singularity/mulled-v2-66534bcbb7031a148b13e2ad42583020b9cd25c4:1679e915ddb9d6b4abda91880c4b48857d471bd8-0'
        cpus   = 32                         // MEASURED: 27.4 cores busy (86%)
        // The only UNDER-request in the pipeline: hifiasm hap2 peaked at 44.8 GB of 48, 93%
        // of its cgroup limit, so a slightly larger assembly OOMs. Still under the 100 GB
        // himem threshold, which is the point -- these five tasks belong on `medium`.
        memory = { 64.GB * task.attempt }   // MEASURED: 44.8 GB worst of five
        time   = { 8.h   * task.attempt }   // MEASURED: 2 h 43 m worst of five
    }

    // MEASURED: 10.9 GB peak, 4.7 min, 1228% of 16 cpus (77% efficient). Left at 16: BUSCO's
    // metaeuk/miniprot stages do not scale to 32, so the old 32-cpu request bought queue
    // time rather than wall time.
    withName: 'BUSCO' {
        container = 'https://depot.galaxyproject.org/singularity/busco:6.1.0--pyhdfd78af_1'
        cpus   = 16                         // MEASURED: 10.3 cores busy (64%)
        memory = { 16.GB * task.attempt }   // MEASURED: 9.7 GB worst of five
        time   = { 1.h   * task.attempt }   // MEASURED: 5 m 4 s worst of five
    }

    // NanoPlot takes --threads but does not use them: MEASURED 98% CPU — one core — across
    // 39.5 minutes on 16 requested, and 0.7 GB of a 64 GB request.
    withName: 'NANOPLOT' {
        container = 'https://depot.galaxyproject.org/singularity/nanoplot:1.42.0--pyhdfd78af_0'
        cpus   = 1                          // MEASURED: 1.0 core, on both runs, again
        memory = { 4.GB * task.attempt }    // MEASURED: 926 MB
        time   = { 2.h  * task.attempt }    // MEASURED: 33 m 43 s
    }

    // Merqury fails hard rather than emitting a blank QV (it exits 0 even when it produces
    // nothing, which would silently leave the QV column empty). But a QC failure must not
    // sink a multi-day assembly run, so it is isolated: the error is visible in the log and
    // the assembly simply carries no QV into the summary.
    //
    // MEASURED: 5.8 GB peak, 17.7 min, 3.8 cores busy. It carried the process_kmer label
    // because it reads a meryl database, but it does not BUILD one — it reserved 200 GB to
    // touch 6, a 2% ratio and the worst in the pipeline.
    withName: 'MERQURY' {
        container = 'https://depot.galaxyproject.org/singularity/merqury:1.3--hdfd78af_1'
        cpus   = 4                          // MEASURED: 2.2 cores busy of 8
        memory = { 12.GB * task.attempt }   // MEASURED: 5.2 GB worst of five
        time   = { 1.h   * task.attempt }   // MEASURED: 13 m 23 s worst of five
        // Merqury is allowed to fail without sinking the run -- QV is nice to have, not
        // essential. But 'ignore' on its own also swallowed SLURM node faults: a broken
        // TaskProlog kills the task before an exit code exists, so task.exitStatus is null
        // and in run 32552323 nine of eleven QV values were silently lost that way.
        // Retry the node faults; ignore anything Merqury itself does wrong.
        errorStrategy = { (task.exitStatus == null || task.exitStatus == Integer.MAX_VALUE)
                          && task.attempt <= 3 ? 'retry' : 'ignore' }
    }

    // smudgeplot 0.2.5 is PINNED, and the version is the interface: 0.4.x renamed the
    // subcommand to `hetmers` and rewrote it to consume a FastK .ktab, which this pipeline
    // does not build. The container lives here rather than in conf/apptainer.config only
    // because the cpus override has to share its block.
    //
    // MEASURED: 176.1 GB peak, 2 h 28 m -- and 99.8% CPU, meaning ONE core. hetkmers is
    // strictly single-threaded, so the process_himem label's 16 cpus reserved 40 core-hours
    // to burn 2. That is not a rounding error on himem, where the binding constraint is the
    // 256-CPU cumulative cap rather than the 20 TB of memory.
    withName: 'SMUDGEPLOT' {
        container = 'https://depot.galaxyproject.org/singularity/smudgeplot:0.2.5--py310r43h7c593f9_4'
        cpus   = 2
        memory = { 260.GB * task.attempt }
        time   = { 6.h    * task.attempt }
    }

    // MEASURED: 1.0 GB peak, 2 m 58 s, 0.7 cores. It streams a meryl database through a
    // filter to stdout, so it is bound by BeeGFS, not by CPU or RAM. Container comes from
    // the MERYL_.* selector in conf/apptainer.config -- a DIFFERENT selector string, so the
    // two blocks merge rather than replacing one another.
    withName: 'MERYL_PRINT' {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = { 1.h  * task.attempt }
    }

    // MEASURED: 100.1 MB peak, 15 m 24 s, 99.9% CPU -- one core, and gzip-bound at that.
    // Container comes from the shared python selector in conf/apptainer.config.
    withName: 'FCS_GX_CLEAN' {
        cpus   = 2
        memory = { 4.GB * task.attempt }
        time   = { 1.h  * task.attempt }
    }

    // NuclearPhaser has no image at all -- build containers/nuclearphaser.def once and point
    // --nuclearphaser_sif at the result. Null until then, which is why the parameter
    // validation refuses to start the branch without it rather than failing mid-run. Closure,
    // not a bare params read, so the value resolves per task rather than baking in null at
    // parse time. The container is declared HERE, not in conf/apptainer.config, because this
    // block also carries an errorStrategy and a repeated selector across two files replaces
    // rather than merges.
    //
    // The errorStrategy is the point of this block. modules/local/nuclearphaser.nf has always
    // said "Non-zero exit is contained: this is an experimental branch and must not sink a run
    // that has already spent days on assemblies" -- but nothing implemented it, so the generic
    // 'finish' applied. In job 34148173 the first real NUCLEARPHASER task exited 1 and did
    // precisely what that comment forbids, cancelling a run holding four finished assemblies.
    // Same shape as HICANU and MERQURY: retry a SLURM node fault, where the task never ran and
    // has no exit code, but ignore anything NuclearPhaser itself does wrong.
    withName: 'NUCLEARPHASER' {
        container = { params.nuclearphaser_sif ?: null }
        errorStrategy = { (task.exitStatus == null || task.exitStatus == Integer.MAX_VALUE)
                          && task.attempt <= 3 ? 'retry' : 'ignore' }
    }

    // SCAFFOLDING. All three of these are cheap next to an assembler, and all three are
    // contained the same way NUCLEARPHASER is: scaffolding runs at the very end of a pipeline
    // holding days of finished assemblies, and a scaffolder that cannot resolve one haplotype
    // must not take the run down with it. The contigs are the deliverable; scaffolds are an
    // improvement on top.
    //
    // HIC_BAM is a sort, so memory is the sort buffer: -m 1G per thread in the module, plus
    // headroom. It reads a whole Hi-C library, so give it time rather than cores.
    withName: 'HIC_BAM' {
        container = 'https://depot.galaxyproject.org/singularity/samtools:1.21--h50ea8bc_0'
        cpus   = 8
        memory = { 16.GB * task.attempt }
        time   = { 8.h   * task.attempt }
        errorStrategy = { (task.exitStatus == null || task.exitStatus == Integer.MAX_VALUE)
                          && task.attempt <= 3 ? 'retry' : 'ignore' }
    }

    // YaHS holds the contact matrix in memory and is single-threaded for most of its run, so
    // cores buy little. UNMEASURED on this data -- these are starting points, not evidence.
    withName: 'YAHS' {
        container = 'https://depot.galaxyproject.org/singularity/yahs:1.2a.2--he4a0461_2'
        cpus   = 4
        memory = { 32.GB * task.attempt }
        time   = { 12.h  * task.attempt }
        errorStrategy = { (task.exitStatus == null || task.exitStatus == Integer.MAX_VALUE)
                          && task.attempt <= 3 ? 'retry' : 'ignore' }
    }

    // HapHiC has no image -- build containers/haphic.def once and point --haphic_sif at the
    // result. Declared HERE rather than in conf/apptainer.config because this block also
    // carries resources and an errorStrategy, and a repeated selector across two files
    // replaces rather than merges. Closure, not a bare params read, so the value resolves per
    // task rather than baking in null at parse time.
    //
    // It runs a clustering and a reassignment pass over the whole contact graph and is the
    // heavier of the two. UNMEASURED on this data.
    withName: 'HAPHIC' {
        container = { params.haphic_sif ?: null }
        cpus   = 16
        memory = { 64.GB * task.attempt }
        time   = { 24.h  * task.attempt }
        errorStrategy = { (task.exitStatus == null || task.exitStatus == Integer.MAX_VALUE)
                          && task.attempt <= 3 ? 'retry' : 'ignore' }
    }

    // ---- Mitochondrial screening ----------------------------------------------------------
    // Two processes because no single stock image has both minimap2 and python3; see the
    // header of modules/local/mito_screen.nf. Containers are declared HERE rather than in
    // conf/apptainer.config because these blocks also carry resources, and a repeated
    // selector across two files replaces rather than merges.
    //
    // BLASTn against the RefSeq mitochondrion release (~18,000 records, 600 Mb), including
    // the makeblastdb step. MEASURED on mlp98AG31 hap1: makeblastdb plus a 104 Mb query took
    // under 4 minutes at 8 threads, peak well under 32 GB.
    withName: 'MITO_ALIGN' {
        container = 'https://depot.galaxyproject.org/singularity/blast:2.16.0--h66d330f_4'
        cpus   = 8
        memory = { 32.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }

    // Pure python over a PAF and a FASTA: single core, and the memory is one assembly held
    // as strings while it is rewritten.
    withName: 'MITO_CALL' {
        container = 'https://depot.galaxyproject.org/singularity/python:3.12'
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = { 1.h  * task.attempt }
    }
}
