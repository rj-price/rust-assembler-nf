/*
 * DATASET PROFILE — Melampsora larici-populina 98AG31 (poplar rust).
 *
 * This is the VALIDATION dataset, not a project. It exists so the pipeline can be run end to
 * end on data whose correct answer is already published: Duplessis et al., "Haplotype-phased
 * assemblies of the two poplar rust fungi species: Melampsora larici-populina and Melampsora
 * allii-populina", G3, 2026-08-29, doi:10.1093/g3journal/jkag247.
 *
 * Target metrics are in assets/reference_metrics_mlp98AG31.tsv, transcribed from the paper's
 * Table 1. Read that file before judging a run here -- the published assembly is Hi-C
 * SCAFFOLDED, so only some of its columns are comparable to raw contigs.
 *
 * Data (public, from ENA; the published assemblies themselves are on JGI Mycocosm only):
 *     SRR38112757  PacBio Revio HiFi, 25.3 Gb   PRJNA1453918
 *     SRR38116149  Hi-C NovaSeq X,    19.8 Gb   PRJNA1454031
 *
 * Usage:  nextflow run rj-price/rust-assembler-nf -profile mlp,<site> --outdir <dir>
 *
 * Published result (hifiasm Hi-C haplotypes vs Table 1) is summarised in README.md,
 * "Validation".
 */

params {

    // ---- Genome expectations --------------------------------------------------------
    // Table 1: the phased haplotypes are 100.80 Mb (H0) and 102.64 Mb (H1), so ~101 Mb
    // haploid and ~203 Mb for the dikaryon. Roughly a fifth of a typical ~500 Mb rust, which is
    // the point -- a full run here costs hours, not days.
    genome_size           = '101m'
    assembler_genome_size = '101m'

    // 25.3 Gb HiFi, stated in the paper's methods and confirmed by ENA's base_count for
    // SRR38112757. About 125x on the dikaryon.
    read_yield_bases      = 25296562314

    // ---- Species --------------------------------------------------------------------
    fcs_gx_taxid          = 203908                // Melampsora laricis-populina
                                                  // (NCBI's spelling; "larici-" finds nothing)

    // basidiomycota, NOT the pipeline's pucciniomycetes default. The paper scored BUSCO v5
    // against the Basidiomycota reference set, and Table 1's 90.5%/90.6% are only meaningful
    // against the same lineage. Using pucciniomycetes here would produce a number that looks
    // comparable and is not.
    busco_lineage         = 'basidiomycota_odb12'

    // ---- Assembly -------------------------------------------------------------------
    // The paper used hifiasm v0.19.9-r616 in Hi-C integration mode with DEFAULT parameters.
    // Default purge level is 3; -l 1 is this pipeline's default, chosen to keep both
    // nuclei separate (DECISION D11). Left at the default here so the run is a
    // like-for-like reproduction rather than our variant of it.
    hifiasm_purge_level   = 3

    // One readset, one question. The ALL/run1/run2 comparison has nothing to compare.
    subset_assemblies     = false

    // ---- Host -----------------------------------------------------------------------
    // Populus, but no host mapping is wired for this dataset -- the published assembly gives
    // a cleaner check on contamination than a read-level host rate would.
    host_reference        = null

    // ---- Full validation run ----------------------------------------------------------
    // Everything the paper's result depends on is switched on, so `-profile <this>,<site>` on
    // its own reproduces the validation. All inputs are public URLs; Nextflow downloads them
    // into the work directory on first use (tens of GB, so launch where that is allowed).
    // ENA names the HiFi file _subreads, but it is HiFi (CCS) data.
    input                 = "${projectDir}/assets/samplesheet_mlp98AG31.csv"
    hic_r1                = 'https://ftp.sra.ebi.ac.uk/vol1/fastq/SRR381/049/SRR38116149/SRR38116149_1.fastq.gz'
    hic_r2                = 'https://ftp.sra.ebi.ac.uk/vol1/fastq/SRR381/049/SRR38116149/SRR38116149_2.fastq.gz'

    run_verkko            = true
    run_scaffolding       = true

    // NuclearPhaser needs its container built locally (containers/nuclearphaser.def) and
    // --nuclearphaser_sif set, usually in the site profile. The gene set is the
    // M. larici-populina v1 CDS from NCBI RefSeq, as in the paper.
    run_nuclearphaser     = true
    nuclearphaser_genes   = 'https://ftp.ncbi.nlm.nih.gov/genomes/all/GCF/000/204/055/GCF_000204055.1_v1.0/GCF_000204055.1_v1.0_cds_from_genomic.fna.gz'

    // The database the paper searched for mitochondrial contigs.
    run_mito_screen       = true
    mito_reference        = 'https://ftp.ncbi.nlm.nih.gov/refseq/release/mitochondrion/mitochondrion.1.1.genomic.fna.gz'
}
