/*
 * Apptainer / containers.
 *
 * Containers first, by design. hifiasm, canu and kraken2 are not installed on most clusters,
 * and containers also pin versions so a rerun in six months is the same software. Images come
 * from the Galaxy depot, which serves prebuilt Singularity images of the biocontainers — no
 * docker->sif conversion needed.
 *
 * Version pins are deliberate. Do not float them to :latest.
 *
 * Cache location and bind mounts are SITE-specific and come from params, so this file is
 * portable. See conf/gruffalo.config for a worked example of setting them.
 */

apptainer {
    enabled     = true
    autoMounts  = true
    // Falls back to $NXF_APPTAINER_CACHEDIR, then to Apptainer's own default. Images run to
    // tens of GB, so on a cluster with $HOME quotas set params.apptainer_cache elsewhere.
    cacheDir    = params.apptainer_cache
                    ?: System.getenv('NXF_APPTAINER_CACHEDIR')
                    ?: "${System.getProperty('user.home')}/.apptainer/cache"
    // Databases live outside the work directory, so they are invisible inside the container
    // unless bound explicitly. Set params.container_binds in your site profile.
    runOptions  = params.container_binds ?: ''
}

// Belt and braces: never let a stray docker directive take over.
docker.enabled     = false
singularity.enabled = false
conda.enabled      = false

// CRITICAL: do NOT add a `withName` selector here whose selector string also appears in
// conf/base.config. Nextflow does NOT deep-merge process selector blocks across included
// config files — the later file REPLACES the earlier block wholesale, silently. In run
// 32466998 that wiped the resource settings for FLYE, HICANU, KRAKEN2, FCS_GX, MINIMAP2_.*,
// BUSCO and MERQURY, which then fell back to their generic label. FCS-GX ran at 220 GB
// instead of its intended allocation and thrashed against a 498 GB index.
//
// Any process needing BOTH a container and a resource override declares both together in
// conf/base.config. Container-only processes stay here.
process {

    withName: 'SEQKIT_.*'    { container = 'https://depot.galaxyproject.org/singularity/seqkit:2.8.2--h9ee0642_0' }
    // NANOPLOT's container lives in conf/base.config, beside its resource override — the two
    // must share one block or Nextflow silently drops whichever file it reads first.

    withName: 'MERYL_.*'     { container = 'https://depot.galaxyproject.org/singularity/meryl:1.4.1--h4ac6f70_0' }
    withName: 'GENOMESCOPE2' { container = 'https://depot.galaxyproject.org/singularity/genomescope2:2.0.1--py313r44hdfd78af_1' }
    // PINNED TO 0.2.5, NOT the newest 0.4.0, and the version IS the interface here.
    // 0.4.x renamed the subcommand to `hetmers` and rewrote it to consume a FastK .ktab
    // database; it cannot read a k-mer dump at all, and FastK is not in the image. This
    // pipeline's k-mer database is meryl's, and `meryl print` emits exactly the
    // Jellyfish/KMC-style dump that 0.2.5's `hetkmers` reads. Moving to 0.4.x would mean
    // building a second, FastK copy of a database that already costs ~2.5 h and 83 GB.
    // Verified against this project's own data before pinning: 0.2.5 hetkmers on a slice of
    // rust_all.kmers_in_range.tsv produced coverages and families files, exit 0.
    // SMUDGEPLOT's container moved to conf/base.config on 2026-09-02, beside its cpus
    // override -- one block, or Nextflow silently drops whichever file it reads first. The
    // pin rationale above still applies and is repeated there.
    // smudgeplot's documented workflow calls meryl in the middle, but no biocontainer holds
    // both tools -- hence three processes across two images. MERYL_PRINT needs no entry of its
    // own: the MERYL_.* selector above already gives it the same meryl image as MERYL_COUNT,
    // which is what it must have, since a meryl database is not portable across versions.
    withName: 'SMUDGEPLOT_CUTOFF' { container = 'https://depot.galaxyproject.org/singularity/smudgeplot:0.2.5--py310r43h7c593f9_4' }


    // HIFIASM's container lives in conf/base.config, beside its resource override — the two
    // must share one block or Nextflow silently drops whichever file it reads first.
    // Verkko 2.3.2, NOT 2.2.1. Verkko bundles MBG as a git submodule and pins it: 2.2.1 pins
    // MBG at f312a89 (2023-05-25), whose src/MsatValueVector.cpp line 94 is literally
    // `assert(realsize < 255);`. Job 34040779 hit exactly that after ~9 h of real work --
    // an 8-bit counter overflowing on this genome's satellite arrays. MBG 8fe41e8 (2023-09-22)
    // rewrote MsatValueVector and dropped both the counter and the assert; verkko 2.3.2 pins
    // MBG at 2e1d44b (2025-09-15), and `strings` on its bundled binary finds no such assert.
    // Verkko hard-codes --error-masking=collapse-msat in Snakefiles/1-buildGraph.sm and offers
    // no pass-through, so upgrading was the only route -- params.verkko_extra cannot reach it.
    withName: 'VERKKO'       { container = 'https://depot.galaxyproject.org/singularity/verkko:2.3.2--hb0edd9e_0' }

    // IPA: locally built, never a stock biocontainer. All four pbipa 1.8.0 builds on the
    // Galaxy depot ship BusyBox sort (no --temporary-directory, which ipa2-task's overlap
    // step requires) and the newest also ships snakemake 8, which rejects IPA's --reason.
    // containers/ipa.def carries the full diagnosis. Closure, not a bare params read, so the
    // value is resolved per task rather than baked in as null at parse time.
    withName: 'IPA'          { container = { params.ipa_sif ?: null } }

    withName: 'GFASTATS'     { container = 'https://depot.galaxyproject.org/singularity/gfastats:1.3.7--hdcf5f25_0' }

    withName: 'SAMTOOLS_.*'  { container = 'https://depot.galaxyproject.org/singularity/samtools:1.21--h50ea8bc_0' }

    withName: 'MULTIQC'      { container = 'https://depot.galaxyproject.org/singularity/multiqc:1.25.1--pyhdfd78af_0' }

    // ---- Phasing (NuclearPhaser branch) ---------------------------------------------
    //
    // NuclearPhaser's published recipe uses BioKanga and HiC-Pro. Neither has a container
    // anywhere on the Galaxy depot, and BioKanga is unmaintained. Both are replaced here by
    // maintained, containerised tools that produce byte-compatible input for NuclearPhaser:
    // pblat for the PSL gene mapping, and the standard bwa/pairtools/cooler route for the
    // 7-column contact map. See the module headers for why those substitutions are safe.
    withName: 'PBLAT_GENES'     { container = 'https://depot.galaxyproject.org/singularity/pblat:2.5.1--h84c94e8_3' }
    withName: 'HIC_ALIGN'       { container = 'https://depot.galaxyproject.org/singularity/bwa:0.7.18--he4a0461_1' }
    withName: 'HIC_PAIRS'       { container = 'https://depot.galaxyproject.org/singularity/pairtools:1.1.3--py39h7a39fba_0' }
    withName: 'HIC_MATRIX'      { container = 'https://depot.galaxyproject.org/singularity/cooler:0.9.3--pyhdfd78af_0' }

    // NUCLEARPHASER's container lives in conf/base.config, beside its errorStrategy — the two
    // must share one block or Nextflow silently drops whichever file it reads first.

    // Hi-C scaffolding. HIC_BAM is the shared bridge from HIC_ALIGN's gzipped SAM to the
    // indexed FASTA + name-sorted BAM both scaffolders want; it is named HIC_BAM rather than
    // SAMTOOLS_* on purpose, because 'SAMTOOLS_.*' above would then claim it and the two
    // selectors would be fighting over one process.
    // All three live in conf/base.config, beside their resources and errorStrategy — the two
    // must share one block or Nextflow silently drops whichever file it reads first. Naming
    // note kept here because this is where you would look for them: HIC_BAM is not called
    // SAMTOOLS_* on purpose, or the 'SAMTOOLS_.*' selector above would claim it and the two
    // would fight over one process.

    // Small pure-python helpers in bin/ need only a stock python.
    //
    // '.*_RECORD' and TELOMERES are covered explicitly because they do NOT match
    // '.*_SUMMARY'. Without it the process fell through to the host's conda python, which is
    // 3.6 — and that is what made every ASSEMBLY_RECORD task in run 32466998 die on
    // argparse's `required=` kwarg. Any new bin/ helper must be added to this selector.
    //
    // '.*_RECORD' was widened from a bare 'ASSEMBLY_RECORD' when SCAFFOLD_RECORD arrived, so
    // the next per-assembly record process is covered on arrival rather than silently falling
    // through to python 3.6. Every process it currently matches is a bin/ helper wanting a
    // stock python: ASSEMBLY_RECORD, SCAFFOLD_RECORD, and the four *_SUMMARY processes.
    withName: '.*_SUMMARY|.*_HISTOGRAMS|.*_RECORD|TELOMERES|FCS_GX_CLEAN' { container = 'https://depot.galaxyproject.org/singularity/python:3.12' }
}
