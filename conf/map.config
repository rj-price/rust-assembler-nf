/*
 * DATASET PROFILE — Melampsora allii-populina 12AY07 (poplar rust).
 *
 * The SECOND validation dataset, alongside conf/mlp.config, from the same paper: Duplessis et
 * al., G3 2026, doi:10.1093/g3journal/jkag247. Where mlp is small and clean, this one is the
 * harder test: a ~222 Mb haploid genome that is 82% transposable elements, with 22% BUSCO
 * duplication in the old collapsed v1. It checks that the pipeline's answer on mlp was not
 * specific to an easy genome.
 *
 * Target metrics are in assets/reference_metrics_map12AY07.tsv, transcribed from Table 2.
 * As for mlp, the published H0/H1 are SCAFFOLDED, so read that file's header before judging.
 *
 * Data (public, from ENA):
 *     SRR38112758  PacBio Revio HiFi, 39.7 Gb      PRJNA1453918
 *     SRR38116150  Hi-C NovaSeq X,    55.4 M pairs PRJNA1454031
 *
 * Usage:  nextflow run rj-price/rust-assembler-nf -profile map,<site> --outdir <dir>
 *
 * Published result (hifiasm Hi-C haplotypes vs Table 2) is summarised in README.md,
 * "Validation".
 */

params {

    // ---- Genome expectations --------------------------------------------------------
    // Table 2: 224.03 Mb (H0) and 219.39 Mb (H1), so ~222 Mb haploid and ~444 Mb for the
    // dikaryon (415.95 Mb in phased haplotypes plus 8.53 Mb unplaced).
    genome_size           = '222m'
    assembler_genome_size = '222m'

    // 39.7 Gb HiFi (methods) = ENA base_count for SRR38112758. About 90x on the dikaryon.
    read_yield_bases      = 39666974653

    // ---- Species --------------------------------------------------------------------
    fcs_gx_taxid          = 242475                // Melampsora allii-populina

    // basidiomycota, as for mlp: Table 2's 90.7%/86.1% are scored against that set.
    busco_lineage         = 'basidiomycota_odb12'

    // ---- Assembly -------------------------------------------------------------------
    // Same method as mlp: hifiasm v0.19.9-r616, Hi-C integration mode, default parameters.
    hifiasm_purge_level   = 3

    subset_assemblies     = false

    host_reference        = null

    // ---- Full validation run ----------------------------------------------------------
    // Everything the paper's result depends on is switched on, so `-profile <this>,<site>` on
    // its own reproduces the validation. All inputs are public URLs; Nextflow downloads them
    // into the work directory on first use (tens of GB, so launch where that is allowed).
    // ENA names the HiFi file _subreads, but it is HiFi (CCS) data.
    input                 = "${projectDir}/assets/samplesheet_map12AY07.csv"
    hic_r1                = 'https://ftp.sra.ebi.ac.uk/vol1/fastq/SRR381/050/SRR38116150/SRR38116150_1.fastq.gz'
    hic_r2                = 'https://ftp.sra.ebi.ac.uk/vol1/fastq/SRR381/050/SRR38116150/SRR38116150_2.fastq.gz'

    run_verkko            = true
    run_scaffolding       = true

    // NuclearPhaser needs its container built locally (containers/nuclearphaser.def) and
    // --nuclearphaser_sif set, usually in the site profile. The gene set is the
    // M. larici-populina v1 CDS from NCBI RefSeq, as in the paper.
    run_nuclearphaser     = true
    nuclearphaser_genes   = 'https://ftp.ncbi.nlm.nih.gov/genomes/all/GCF/000/204/055/GCF_000204055.1_v1.0/GCF_000204055.1_v1.0_cds_from_genomic.fna.gz'

    // The database the paper searched for mitochondrial contigs.
    run_mito_screen       = true
    mito_reference        = 'https://ftp.ncbi.nlm.nih.gov/refseq/release/mitochondrion/mitochondrion.1.1.genomic.fna.gz'
}
