/*
 * rust-assembler-nf
 *
 * Phased assembly of a dikaryotic rust (Pucciniales) genome from PacBio HiFi reads.
 *
 * This is a research/decision pipeline: it produces several assembly candidates plus the
 * evidence needed to judge them. It does NOT try to emit one "final" FASTA.
 *
 * NOTHING IN THIS FILE IS SITE-SPECIFIC. Cluster paths, databases, queue routing and
 * container caches live in a site profile (conf/gruffalo.config is the worked example).
 * Species- and dataset-specific values live in a dataset profile (conf/mlp.config is the
 * worked example). Keeping the three apart is deliberate — see
 * README.md, "Porting to another cluster" and "Running your own rust".
 */

params {

    // ---- Input / output -------------------------------------------------------------
    input                     = null                    // samplesheet CSV: sample,run,fastq

    // Defaults to ./results relative to the LAUNCH directory, as is conventional. On a
    // cluster where $HOME is backed up and file-count-capped, publishing an assembly tree
    // there throttles job concurrency — set forbid_home_outdir in the site profile and the
    // pipeline refuses rather than doing it silently. (Not hypothetical: a run once
    // published 58 MB into $HOME because --outdir was omitted.)
    outdir                    = "${launchDir}/results"
    forbid_home_outdir        = false                   // site profiles set this true

    // ---- Genome expectations --------------------------------------------------------
    // REQUIRED. Haploid size of ONE nucleus, e.g. '525m'. Rust genomes span roughly 100 Mb
    // to 2 Gb, so there is no defensible default; the pipeline asks rather than guesses.
    // Drives size_flag scoring and the expected read depth.
    genome_size               = null

    // The size actually HANDED TO THE ASSEMBLERS, kept separate from the estimate above on
    // purpose. Flye and HiCanu interpolate this into their command lines, so it is part of
    // their task hash: changing it silently invalidates a completed multi-day assembly on
    // the next -resume. Pinning it is therefore also a provenance record. Null means "use
    // genome_size"; set it explicitly once assemblies exist and you refine the estimate.
    assembler_genome_size     = null

    // Total sequenced yield in bases. Optional: when set, COVERAGE_SUMMARY compares the
    // observed depth modes against yield / (2 x genome_size). When null the modes are still
    // detected and reported, just not scored against an expectation.
    read_yield_bases          = null

    // size_flag bounds, as a FRACTION of the expected 2 x genome_size dikaryon. Fractions
    // rather than absolute byte counts, so they track --genome_size instead of going stale.
    // The band is deliberately asymmetric: modestly over is ordinary (residual duplication),
    // whereas landing near 1x haploid is the collapse this pipeline exists to detect.
    dikaryon_size_frac_min    = 0.95
    dikaryon_size_frac_max    = 1.10

    // ---- Read QC / filtering --------------------------------------------------------
    // No filtering by default. Long reads with a poorer reported Q are often the ones doing
    // the phasing work (DECISION D2): on the dataset this was built for, the reads a Q30
    // filter would have discarded gave measurably better-balanced haplotypes.
    // Setting either of these creates a SEPARATE filtered dataset; raw input is untouched.
    min_read_length           = 0
    min_read_q                = 0

    // Assemble the filtered dataset as well as the raw one, so "did filtering actually help?"
    // is answerable rather than assumed. Opt-in and inert unless a filter is actually set:
    // with min_read_length and min_read_q both 0 there is no filtered dataset to assemble.
    // Produces the `filtered` readset; the raw `all` readset is always assembled too.
    filtered_assembly         = false

    // ---- Read subsets (diagnostic) --------------------------------------------------
    // Answers "are the longer reads actually helping?" by assembling each run separately as
    // well as pooled. Triples the most expensive process, so it is opt-in.
    subset_assemblies         = false

    // ---- Assemblers -----------------------------------------------------------------
    run_hifiasm               = true
    run_flye                  = true
    run_hicanu                = true
    run_verkko                = false                   // HiFi-only it mostly repeats hifiasm; useful with Hi-C + NuclearPhaser

    // hifiasm -l purge level: 0 none, 1 light, 2 moderate, 3 aggressive.
    // hifiasm's own default is 3 (aggressive), which actively collapses haplotypic
    // duplication — the opposite of what a dikaryon project wants. Defaulting to 1 here is
    // deliberate. -l 0 may be more appropriate still on a highly heterozygous dikaryon.
    hifiasm_purge_level       = 1

    hifiasm_extra             = ''
    flye_extra                = ''
    hicanu_extra              = ''
    verkko_extra              = ''

    // IPA (PacBio's Improved Phased Assembler). On by default: a fourth independent
    // assembler, and the only one here using the Pancake overlapper. It is unmaintained
    // upstream (last commit 2022-03-11) and no stock biocontainer of it works, so it needs a
    // locally built image -- see containers/ipa.def. Site profiles set ipa_sif; main.nf
    // refuses to start without it rather than failing hours in.
    run_ipa                   = true
    ipa_sif                   = null
    ipa_extra                 = ''

    // ---- Hi-C phasing (inert without Hi-C reads) ------------------------------------
    // HiFi-only phasing produces hifiasm's PARTIALLY phased bp.hap1/bp.hap2. On a dikaryon
    // that is often not a clean separation of the two nuclei. Supplying Hi-C switches hifiasm
    // to fully-phased hic.hap1/hic.hap2 with no other change to the pipeline.
    hic_r1                    = null
    hic_r2                    = null

    // ---- NuclearPhaser (Hi-C phasing of ANY assembly) -------------------------------
    // hifiasm's --h1/--h2 above phases inside hifiasm, so Hi-C benefits hifiasm and nothing
    // else. NuclearPhaser (Sperschneider et al.) instead phases an EXISTING assembly into two
    // nuclear haplotypes using Hi-C contacts plus gene/BUSCO synteny, so the same Hi-C data
    // can be applied to the Flye, HiCanu and Verkko candidates too — and to a hifiasm primary
    // as an independent check on hifiasm's own phasing.
    //
    // It is specifically designed for dikaryotic rusts, which is exactly this pipeline's case.
    //
    // Requires --hic_r1/--hic_r2 AND a gene set (--nuclearphaser_genes): nucleotide gene
    // sequences to map onto the assembly for the synteny signal. A published gene set from a
    // related rust is the usual source. Inert without both.
    run_nuclearphaser         = false
    nuclearphaser_genes       = null    // FASTA of gene sequences for the synteny signal
    // Which candidates to phase. A regex on the assembly id — phasing every candidate is
    // wasteful, and the sensible target is a cleaned primary from each assembler.
    nuclearphaser_targets     = '.*_(primary)$'
    // ...and of those, skip any whose cleaned size marks it collapsed (one nucleus): it has
    // nothing to phase and NuclearPhaser crashes on it. See subworkflows/local/phasing.nf.
    nuclearphaser_skip_collapsed = true
    // No biocontainer exists for NuclearPhaser (checked against the Galaxy depot: no
    // nuclearphaser, no biokanga, no hic-pro image). Build the bundled definition once:
    //     apptainer build nuclearphaser.sif containers/nuclearphaser.def
    // and point this at the result. Everything else in the phasing path (pblat, bwa,
    // pairtools, cooler, hicexplorer) is a stock biocontainer.
    nuclearphaser_sif         = null
    // Resolution of the Hi-C contact matrix handed to NuclearPhaser. 100 kb at MAPQ 10 is the
    // author's recommended setting; 20 kb at MAPQ 30 is the documented alternative.
    hic_matrix_resolution     = 100000
    hic_min_mapq              = 10

    // ---- Hi-C scaffolding (contigs -> chromosomes) -----------------------------------
    // Phasing says WHICH nucleus a contig belongs to; scaffolding says WHERE in that nucleus
    // it sits. They are separate questions and this pipeline had only ever answered the first,
    // which is why it could report contig N50 but never the scaffold N50 that published
    // assemblies are quoted in.
    //
    // Nothing is invented here: a scaffolder orders and orients existing contigs and pads the
    // joins with Ns. Scaffolds are published under scaffolding/ and are deliberately NOT fed
    // back into the candidate comparison — ranking a scaffolded assembly against contig-level
    // ones on N50 would compare two different things, which DECISION D7 already warns about.
    //
    // Requires --hic_r1/--hic_r2. Inert without --run_scaffolding.
    run_scaffolding           = false
    // 'yahs' or 'haphic'. YaHS is the default because it needs no local container build and
    // no expected chromosome count. HapHiC is the better fit for a dikaryon and is what
    // Duplessis et al. (2026) used for M. allii-populina, but it needs both.
    scaffolder                = 'yahs'
    // Which assemblies to scaffold. A regex on the assembly id, matching FULLY phased
    // haplotypes only by default: hifiasm's Hi-C fully_phased_hap1/hap2 and NuclearPhaser's
    // np_hap0/np_hap1.
    //
    // partially_phased_hap1/hap2 are deliberately EXCLUDED, and the exclusion is the point.
    // Those are hifiasm's HiFi-only bp.hap1/bp.hap2, which on a dikaryon are frequently not a
    // separation of the two nuclei at all (README "Assembly type vocabulary") -- so scaffolding them asks the same ill-posed question as
    // scaffolding a collapsed primary, and answers it just as confidently. A stub run with the
    // looser '.*_hap[0-9]+$' scaffolded them without complaint, which is exactly how this
    // would reach real data unnoticed.
    scaffold_targets          = '.*_(fully_phased|np)_hap[0-9]+$'
    // HapHiC clusters contigs into EXACTLY this many groups, so a wrong value produces
    // confidently wrong chromosomes rather than a degraded result. Per HAPLOTYPE: 18 for
    // M. larici-populina, not the 36 of the dikaryon. Unused by YaHS, which infers the count.
    scaffold_n_chromosomes    = null
    // REPORTING ONLY — this threshold decides nothing and changes no sequence. It splits the
    // scaffold length distribution so scaffold_summary.tsv can say "18 chromosome-scale
    // scaffolds" rather than gfastats' "# scaffolds: 55", which counts the 37 small unplaced
    // ones alongside them. 1 Mb sits in open space on this data, and the gap is not a close
    // call: mlp98AG31 hap1 runs 8.62 Mb down to 4.02 Mb across its 18 chromosome-scale
    // scaffolds, then drops straight to 406 kb — a tenfold cliff, with nothing between 4.02 Mb
    // and 406 kb at all. Anything from ~0.5 to ~4 Mb gives the same answer of 18. Set it per
    // species if that cliff sits elsewhere; l90 is reported alongside and needs no threshold.
    scaffold_chromosome_min_length = 1000000
    // No biocontainer exists for HapHiC (checked against the Galaxy depot; YaHS has one).
    // Build the bundled definition once:
    //     apptainer build haphic.sif containers/haphic.def
    // and point this at the result.
    haphic_sif                = null

    // ---- Contamination --------------------------------------------------------------
    // Database paths are site-specific and have no portable default: set them in a site
    // profile, pass them on the command line, or disable the tool.
    kraken_db                 = null
    run_kraken2               = true
    // Minimum fraction of a read's k-mers that must support a taxon before Kraken2 will call
    // it. Kraken2's own default is 0.0, i.e. a single matching k-mer anywhere in a 15-20 kb
    // HiFi read is enough to claim it. That is how a demonstrably fungal dataset was called
    // 62% human. 0.1 is the usual long-read starting point: it does not make
    // classification trustworthy, it stops the most obviously spurious calls. The output is
    // still EVIDENCE, never a filter.
    kraken2_confidence        = 0.1
    fcs_gx_db                 = null
    fcs_gx_sif                = null

    // ---- Mitochondrial screening ---------------------------------------------------------
    // Off by default, and reference-based when on. FCS-GX cannot find the mitochondrion --
    // it screens for OTHER organisms, and the mitochondrion is this one -- so without this
    // step it stays in the haplotypes. Duplessis et al. (2026) removed it separately, which
    // is part of why their contig counts are lower than ours.
    //
    // mito_reference is a mitogenome FASTA -- ideally the NCBI RefSeq mitochondrion release
    // file, which is what the paper searched:
    //   https://ftp.ncbi.nlm.nih.gov/refseq/release/mitochondrion/mitochondrion.1.1.genomic.fna.gz
    // A single same-genus mitogenome works too, and better, but for M. larici-populina none
    // exists -- RefSeq's nearest Pucciniales entries are Puccinia and Austropuccinia.
    //
    // Thresholds are documented in bin/mito_screen.py. The call is the fraction of a
    // contig's OWN length that aligns, which is what stops a NUMT inside a chromosome-scale
    // contig from deleting a whole chromosome, and both defaults were measured on real
    // mlp98AG31 data rather than guessed.
    run_mito_screen           = false
    mito_reference            = null
    mito_min_identity         = 90       // BLASTn -perc_identity, the paper's value
    mito_min_aligned_frac     = 0.2      // MEASURED gap: true 0.349, worst false 0.041
    mito_max_length           = 500000
    run_fcs_gx                = true
    fcs_gx_taxid              = null                    // REQUIRED when run_fcs_gx: NCBI taxid of YOUR species

    // Assembly cleanup. FCS-GX REPORTS contamination; this acts on that report, writing a
    // NEW cleaned FASTA to derived/ and leaving the original assembly untouched (D6).
    // Contigs whose action is EXCLUDE are dropped whole; TRIM/FIX regions are hard-masked out
    // of the contig. Assembly QC then measures the CLEANED FASTA, since that is the assembly
    // carried forward; FCS-GX itself is not re-run on its own output.
    fcs_gx_clean              = true

    // Host mapping is optional and inert until a reference is supplied. For a rust this is
    // the plant it was harvested from — set it to whichever host FASTA applies to your
    // material, e.g. Phaseolus vulgaris for the bean rust Uromyces appendiculatus.
    host_reference            = null

    // Assemble the host-removed reads as well as the full set, producing the `host_filtered`
    // readset alongside `all`. This is the only way to answer "did removing apparent host
    // contamination actually improve the assembly?" — and the answer is often no. Requires
    // --host_reference; reads are SPLIT into new files, never removed in place (D6).
    host_filtered_assembly    = false

    // ---- k-mer analysis -------------------------------------------------------------
    kmer_size                 = 21
    run_smudgeplot            = true                    // dikaryon sanity check on GenomeScope2

    // ---- Assembly QC ----------------------------------------------------------------
    // pucciniomycetes_odb12 is the correct clade for a rust and a sensible default here.
    // BUSCO must be 6.x to read odb12 lineages — a hard requirement, not a preference,
    // since 5.x cannot parse them.
    busco_lineage             = 'pucciniomycetes_odb12'
    busco_db                  = null                    // directory CONTAINING the lineage dir
    run_busco                 = true
    run_merqury               = true

    // Map hap1+hap2 together so reads must choose between them. The per-assembly mapping
    // cannot tell a phased pair from a collapsed one; MAPQ in a shared index can.
    run_haplotype_competition = true

    // Telomere placement. Counts telomere-capped contig ends (a contiguity measure that,
    // unlike N50, can be read against the expected number of chromosome ends) and INTERNAL
    // telomeres, which indicate mis-joins. Cheap: about a minute per assembly.
    //
    // TTAGGG is canonical for fungi including the rusts, but it is not universal. A wrong
    // motif produces a confidently empty result, so the module warns when no contig end is
    // capped, and the array-length distribution in the per-assembly TSV is the check: real
    // telomeres appear as tens to hundreds of clean tandem units.
    run_telomeres                  = true
    telomere_motif                 = 'TTAGGG'
    telomere_min_units             = 3
    telomere_end_window            = 1000               // bp from a contig end to count as terminal
    telomere_interstitial_min_units = 20                // stricter: short interior runs occur by chance

    // x-axis limit for the overlaid coverage-depth plot. The informative range sits around
    // the expected per-nucleus depth; a long flat repeat tail squashes it.
    coverage_plot_max_depth        = 250

    // ---- Resource ceilings ----------------------------------------------------------
    // Every request is clamped to these. A site profile should raise or lower them to match
    // its per-user queue caps.
    max_cpus                  = 64
    max_memory                = '900.GB'
    max_time                  = '14.d'

    // ---- QC-only re-entry -----------------------------------------------------------
    // Re-run ASSEMBLY_QC + REPORTING over assemblies that already exist, without rebuilding
    // them. ASSEMBLY_QC is provenance-blind by design, so this needs no changes to it.
    //
    // Why this exists: a run whose assemblies all succeeded can still lose its QC tail, and
    // if the resume cache is gone `-resume` would rebuild multi-day assemblies to recover a
    // few hours of QC. This is also the right tool for re-QCing after a QC bug fix.
    //
    //   --qc_only --assemblies_from <outdir>/assembly --meryl_db <outdir>/kmer/meryl/<db>
    //
    qc_only                   = false
    assemblies_from           = null                    // directory to scan for assembly FASTAs
    meryl_db                  = null                    // existing meryl DB, or a directory of
                                                        // per-sample <sample>_*.meryl DBs
    yields_from               = null                    // directory of a previous run's
                                                        // *.seqkit_stats.tsv, for expected depth

    // ---- Cluster health -------------------------------------------------------------
    // Comma-separated nodes to keep away from, or '' for none. Set in a site profile when a
    // node is known bad; an empty value adds no --exclude flag at all.
    exclude_nodes             = ''

    // ---- Containers -----------------------------------------------------------------
    // Where Apptainer caches pulled images. Null falls back to $NXF_APPTAINER_CACHEDIR and
    // then to Apptainer's own default. On a cluster with $HOME quotas, point this at scratch
    // or an apps area in the site profile — images are large and numerous.
    apptainer_cache           = null
    // Extra bind mounts, e.g. '-B /mnt/shared/datasets'. Databases outside the work
    // directory are not visible inside the container without these.
    container_binds           = ''

    // ---- Misc -----------------------------------------------------------------------
    help                      = false
    publish_dir_mode          = 'copy'
    tracedir                  = "${params.outdir}/pipeline_info"
}

includeConfig 'conf/base.config'

profiles {

    // ---- Execution / site -----------------------------------------------------------

    slurm {
        includeConfig 'conf/slurm.config'
    }

    apptainer {
        includeConfig 'conf/apptainer.config'
    }

    // Worked example of a SITE profile: SLURM + Apptainer + this cluster's database paths,
    // caches, queue caps and known-bad nodes. Copy it to add your own cluster.
    gruffalo {
        // ORDER MATTERS. conf/gruffalo.config sets params.apptainer_cache and
        // params.container_binds; conf/apptainer.config READS them into the `apptainer`
        // scope. A config scope is evaluated as it is parsed, not lazily, so with
        // apptainer.config first both params were still null and the block silently took
        // its fallbacks: images cached into $HOME (4.2 GB, against the ~15 GB cap this
        // file's own comment warns about) and runOptions = '' rather than the database
        // bind mounts. The site profile must be parsed BEFORE anything that reads it.
        includeConfig 'conf/slurm.config'
        includeConfig 'conf/gruffalo.config'
        includeConfig 'conf/apptainer.config'
    }

    // ---- Dataset --------------------------------------------------------------------

    // Worked example of a DATASET profile, and the validation dataset -- a published poplar rust with known-good answers. See
    // conf/mlp.config and assets/reference_metrics_mlp98AG31.tsv.
    mlp {
        includeConfig 'conf/mlp.config'
    }

    // Second validation dataset from the same paper -- a larger, TE-rich genome. See
    // conf/map.config and assets/reference_metrics_map12AY07.tsv.
    map {
        includeConfig 'conf/map.config'
    }

    // ---- Development ----------------------------------------------------------------

    test {
        includeConfig 'conf/test.config'
    }

    // Wiring validation only — see conf/stub.config.
    stub {
        includeConfig 'conf/stub.config'
    }

    // Failure isolation for long unattended runs — see conf/robust.config for the trade-off.
    robust {
        includeConfig 'conf/robust.config'
    }

    debug {
        cleanup                = false
        dumpHashes             = true
        process.beforeScript   = 'echo $HOSTNAME'
    }
}

// NOTE: NXF_OPTS is deliberately NOT set here. The `env` scope is exported into every TASK
// environment, not the driver's, and Nextflow writes it unquoted — so every containerised
// task began with
//     /bin/bash: line 0: export: `-Xmx4g': not a valid identifier
// Harmless in itself, but it is noise at the top of every .command.err and it made real
// errors harder to find. The driver heap is capped in run_pipeline.sh, the right place.

// Provenance: every run records what actually happened.
timeline { enabled = true; file = "${params.tracedir}/execution_timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.tracedir}/execution_report.html";   overwrite = true }
trace    { enabled = true; file = "${params.tracedir}/execution_trace.txt";     overwrite = true
           fields  = 'task_id,hash,name,status,exit,submit,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar' }
dag      { enabled = true; file = "${params.tracedir}/pipeline_dag.html";       overwrite = true }

manifest {
    name            = 'rust-assembler-nf'
    author          = 'Jordan Price'
    homePage        = 'https://github.com/rj-price/rust-assembler-nf'
    defaultBranch   = 'main'
    description     = 'Phased assembly and haplotype resolution of dikaryotic rust (Pucciniales) genomes from PacBio HiFi reads'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '1.0.1'
}
